# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# 백엔드 API 주소
# - 로컬: double-check-backend 를 docker-compose 로 띄운 경우
# - 배포: Render 백엔드 주소로 변경
VITE_API_BASE_URL=http://localhost:8080

# 백엔드 인증 API가 나오기 전 화면 개발용 가짜 로그인
# true 이면 아이디에 "staff" 가 들어가면 직원, 그 외는 고객으로 로그인됩니다.
VITE_USE_MOCK_AUTH=true
